            "type": "color",
            "id": "border",
            "label": "Border",
            "default": "#5B5148"
          },
          {
            "type": "color",
            "id": "muted_text",
            "label": "Secondary text",
            "default": "#655B52"
          },
          {
            "type": "color",
            "id": "card_background",
