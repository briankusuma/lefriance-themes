[
  {
    "name": "theme_info",
    "theme_name": "Skeleton",
    "theme_version": "0.1.0",
    "theme_author": "Shopify",
    "theme_documentation_url": "https://help.shopify.com/manual/online-store/themes",
    "theme_support_url": "https://support.shopify.com/"
  },
  {
    "name": "t:general.typography",
    "settings": [
      {
        "type": "header",
        "content": "t:general.fonts"
      },
      {
        "type": "font_picker",
        "id": "type_primary_font",
        "default": "work_sans_n4",
        "label": "t:general.primary"
      },
      {
        "type": "font_picker",
        "id": "type_heading_font",
        "default": "work_sans_n5",
        "label": "Heading font"
      }
    ]
  },
  {
    "name": "t:general.layout",
    "settings": [
      {
        "type": "select",
        "id": "max_page_width",
        "label": "t:labels.page_width",
        "options": [
          {
            "value": "1280px",
            "label": "Compact"
          },
          {
            "value": "1535px",
            "label": "Standard"
          },
          {
            "value": "1800px",
            "label": "Wide"
          }
        ],
        "default": "1535px"
      },
      {
        "type": "range",
        "id": "min_page_margin",
        "min": 20,
        "max": 100,
        "step": 1,
        "unit": "px",
        "label": "t:labels.page_margin",
        "default": 51
      }
    ]
  },
  {
    "name": "t:general.colors",
    "settings": [
      {
        "type": "color_scheme_group",
        "id": "color_schemes",
        "definition": [
          {
            "type": "color",
            "id": "background",
            "label": "Background",
            "default": "#F8F0E8"
          },
          {
            "type": "color",
            "id": "text",
            "label": "Text",
            "default": "#171513"
          },
          {
            "type": "color",
            "id": "button",
            "label": "Button background",
            "default": "#3A322B"
          },
          {
            "type": "color",
            "id": "button_label",
            "label": "Button label",
            "default": "#FFFFFF"
          },
          {
            "type": "color",
            "id": "border",
            "label": "Border",
            "default": "#5B5148"
          }
        ],
        "role": {
          "text": "text",
          "background": {
            "solid": "background",
            "gradient": "background"
          },
          "links": "text",
          "icons": "text",
          "primary_button": "button",
          "on_primary_button": "button_label",
          "primary_button_border": "button",
          "secondary_button": "background",
          "on_secondary_button": "text",
          "secondary_button_border": "text"
        }
      },
      {
        "type": "color_scheme",
        "id": "default_color_scheme",
        "label": "Default color scheme",
        "default": "scheme-light"
      },
      {
        "type": "range",
        "id": "input_corner_radius",
        "label": "Input corner radius",
        "min": 0,
        "max": 24,
        "step": 1,
        "unit": "px",
        "default": 13
      }
    ]
  },
  {
    "name": "Brand",
    "settings": [
      {
        "type": "image_picker",
        "id": "logo",
        "label": "Logo"
      },
      {
        "type": "image_picker",
        "id": "favicon",
        "label": "Favicon"
      }
    ]
  }
]
