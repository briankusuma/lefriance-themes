[
  {
    "name": "theme_info",
    "theme_name": "Skeleton",
    "theme_version": "0.1.0",
    "theme_author": "Shopify",
    "theme_documentation_url": "https://help.shopify.com/manual/online-store/themes",
    "theme_support_url": "https://support.shopify.com/"
  },
  {
    "name": "t:general.typography",
    "settings": [
      {
        "type": "header",
        "content": "t:general.fonts"
      },
      {
        "type": "font_picker",
        "id": "type_primary_font",
        "default": "work_sans_n4",
        "label": "t:general.primary"
      },
      {
        "type": "font_picker",
        "id": "type_heading_font",
        "default": "work_sans_n5",
        "label": "Heading font"
      },
      {
        "type": "font_picker",
        "id": "type_navigation_font",
        "label": "Navigation font",
        "default": "work_sans_n4"
      },
      {
        "type": "range",
        "id": "body_size",
        "label": "Body size",
        "min": 14,
        "max": 22,
        "step": 1,
        "default": 17,
        "unit": "px"
      },
      {
        "type": "range",
        "id": "heading_size",
        "label": "Heading size",
        "min": 32,
        "max": 80,
        "step": 1,
        "default": 51,
        "unit": "px"
      },
      {
        "type": "range",
        "id": "navigation_size",
        "label": "Navigation size",
        "min": 14,
        "max": 22,
        "step": 1,
        "default": 17,
        "unit": "px"
      },
      {
        "type": "range",
        "id": "caption_size",
        "label": "Caption size",
        "min": 12,
        "max": 18,
        "step": 1,
        "default": 15,
        "unit": "px"
      },
      {
        "type": "range",
        "id": "body_line_height",
        "label": "Body line height",
        "min": 1.2,
        "max": 2,
        "step": 0.1,
        "default": 1.5
      },
      {
        "type": "range",
        "id": "heading_tracking",
        "label": "Heading letter spacing",
        "min": -3,
        "max": 2,
        "step": 0.1,
        "default": -1.5,
        "unit": "px"
      }
    ]
  },
  {
    "name": "t:general.layout",
    "settings": [
      {
        "type": "select",
        "id": "max_page_width",
        "label": "t:labels.page_width",
        "options": [
          {
            "value": "1280px",
            "label": "Compact"
          },
          {
            "value": "1535px",
            "label": "Standard"
          },
          {
            "value": "1800px",
            "label": "Wide"
          }
        ],
        "default": "1535px"
      },
      {
        "type": "range",
        "id": "min_page_margin",
        "min": 20,
        "max": 100,
        "step": 1,
        "unit": "px",
        "label": "t:labels.page_margin",
        "default": 51
      },
      {
        "type": "select",
        "id": "section_width",
        "label": "Section width",
        "options": [
          {
            "value": "full",
            "label": "Full width"
          },
          {
            "value": "contained",
            "label": "Contained"
          }
        ],
        "default": "full"
      },
      {
        "type": "range",
        "id": "container_width",
        "label": "Container maximum width",
        "min": 960,
        "max": 1920,
        "step": 20,
        "default": 1440,
        "unit": "px"
      },
      {
        "type": "range",
        "id": "mobile_page_margin",
        "label": "Mobile side spacing",
        "min": 12,
        "max": 32,
        "step": 1,
        "default": 20,
        "unit": "px"
      },
      {
        "type": "range",
        "id": "section_spacing",
        "label": "Section spacing",
        "min": 0,
        "max": 160,
        "step": 4,
        "default": 80,
        "unit": "px"
      },
      {
        "type": "range",
        "id": "grid_gap",
        "label": "Grid spacing",
        "min": 8,
        "max": 48,
        "step": 1,
        "default": 21,
        "unit": "px"
      }
    ]
  },
