<section class="section-shell color-{{ section.settings.color_scheme }}"><div class="container section-content">
  {% liquid
    assign heading = section.settings.heading | default: collection.title
    assign description = section.settings.description | default: collection.description
    assign heading_scheme = section.settings.heading_color_scheme | default: 'scheme-footer'
  %}
  <header class="collection-intro color-{{ heading_scheme }}">
    <h1>{{ heading | escape }}</h1>
    {% if description != blank %}<div class="collection-intro__description rte">{{ description }}</div>{% endif %}
  </header>
  {% if collection.image %}{{ collection.image | image_url: width: 1600 | image_tag: widths: '600, 1000, 1600', sizes: '100vw', loading: 'lazy', alt: collection.image.alt }}{% endif %}
  {% paginate collection.products by 20 %}
    <div class="product-grid">{% for product in collection.products %}{% render 'product-card', card_product: product, instance_id: section.id %}{% else %}<p>{{ 'commerce.empty_collection' | t }}</p>{% endfor %}</div>
    {{ paginate | default_pagination }}
  {% endpaginate %}
</div></section>

{% schema %}
{
  "name": "Main collection",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "info": "Leave blank to use the collection title."
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "info": "Leave blank to use the collection description."
    },
    {
      "type": "color_scheme",
      "id": "heading_color_scheme",
      "label": "Heading color scheme",
      "default": "scheme-footer"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-light"
    }
  ]
}
{% endschema %}
