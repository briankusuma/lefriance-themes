{{ 'section-foundation.css' | asset_url | stylesheet_tag }}
<section class="support-section support-section--featured-collection section-shell color-{{ section.settings.color_scheme }}" style="--product-columns: {{ section.settings.columns }}">
  <div class="{% if section.settings.width == 'container' %}container{% else %}section-content--full{% endif %} section-content">
    <div class="commerce-section__heading"><h2>{{ section.settings.heading | escape }}</h2>{% if section.settings.collection != blank %}<a href="{{ section.settings.collection.url }}">{{ section.settings.link_label | escape }}</a>{% endif %}</div>
    {% if section.settings.collection != blank and section.settings.collection.products_count > 0 %}<div class="product-grid">{% for product in section.settings.collection.products limit: section.settings.limit %}{% render 'product-card', card_product: product, instance_id: section.id %}{% endfor %}</div>{% else %}<p>{{ 'commerce.empty_collection' | t }}</p>{% endif %}
  </div>
</section>

{% schema %}
{
  "name": "Featured collection",
  "disabled_on": {
    "groups": [
      "header",
      "footer"
    ]
  },
  "settings": [
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Highlight a collection"
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Link label",
      "default": "View collection"
    },
    {
      "type": "range",
      "id": "limit",
      "label": "Products to show",
      "min": 2,
      "max": 24,
      "step": 1,
      "default": 4
    },
    {
      "type": "range",
      "id": "columns",
      "label": "Desktop columns",
      "min": 2,
      "max": 5,
      "step": 1,
      "default": 4
    },
    {
      "type": "select",
      "id": "width",
      "label": "Content width",
      "options": [
        {
          "value": "container",
          "label": "Container"
        },
        {
          "value": "full",
          "label": "Full width"
        }
      ],
      "default": "container"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-light"
    }
  ],
  "presets": [
    {
      "name": "Featured collection"
    }
  ]
}
{% endschema %}
