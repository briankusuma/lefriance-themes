{{ 'section-foundation.css' | asset_url | stylesheet_tag }}
<section class="support-section support-section--search section-shell color-{{ section.settings.color_scheme }}">
  <div class="container section-content">
  <h1>{{ 'search.title' | t }}</h1>

  <form action="{{ routes.search_url }}" method="get" role="search">
    <label for="Search-{{ section.id }}">{{ 'search.title' | t }}</label>
    <input
      id="Search-{{ section.id }}"
      type="search"
      size="50"
      name="q"
      value="{{ search.terms | escape }}"
      placeholder="{{ 'search.placeholder' | t }}"
    >
    <button type="submit">{{ 'search.submit' | t }}</button>
  </form>

  {% assign escaped_terms = search.terms | escape %}
  {% if search.performed %}
    {% if search.results_count == 0 %}
      <p>{{ 'search.no_results_html' | t: terms: escaped_terms }}</p>
    {% else %}
      <p>{{ 'search.results_for_html' | t: terms: escaped_terms, count: search.results_count }}</p>

      <div class="search-results">
        {% paginate search.results by 20 %}
          {% # Search result items may be an article, a page, or a product. %}
          {% for result in search.results %}
            <div class="search-result">
              {% if result.object_type == 'product' %}
                {% render 'product-card', card_product: result, instance_id: section.id %}
              {% else %}
              {% assign featured_image = result.featured_image | default: result.image %}
              {% if featured_image %}
                {% render 'image', class: 'search-result__image', image: featured_image, url: result.url, width: 400 %}
              {% endif %}
              <div class="search-result__content">
                <p>
                  <a href="{{ result.url }}">{{ result.title | escape }}</a>
                  {% if result.price %}
                    {{ result.price | money_with_currency }}
                  {% endif %}
                </p>
              </div>
              {% endif %}
            </div>
          {% endfor %}

          {{ paginate | default_pagination }}
        {% endpaginate %}
      </div>
    {% endif %}
  {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "Main search",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-light"
    }
  ]
}
{% endschema %}
