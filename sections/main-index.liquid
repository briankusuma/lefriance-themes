{{ 'section-foundation.css' | asset_url | stylesheet_tag }}
<section class="support-section support-section--index section-shell color-{{ section.settings.color_scheme }}">
  <div class="container section-content"><h1>{{ shop.name | escape }}</h1>  </div>
</section>

{% schema %}
{
  "name": "Home page",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-light"
    }
  ]
}
{% endschema %}
