<script src="{{ 'product-features.js' | asset_url }}" defer></script>
{% liquid
  assign recommendation_source = 'empty'
  assign recommendation_products = recommendations.products
  if recommendations.performed? and recommendations.products_count > 0
    assign recommendation_source = 'native'
  elsif section.settings.fallback_products != blank
    assign recommendation_products = section.settings.fallback_products
    assign recommendation_source = 'selected'
  elsif section.settings.intent == 'related' and section.settings.use_catalog_fallback
    assign fallback_collection = section.settings.fallback_collection | default: collections.all
    assign recommendation_products = fallback_collection.products
    assign recommendation_source = 'fallback'
  endif
  assign scan_limit = section.settings.limit | plus: 1
  assign card_count = 0
%}
{% capture recommendation_cards %}
  {% for recommended_product in recommendation_products limit: scan_limit %}
    {% if recommended_product.id == product.id %}{% continue %}{% endif %}
    {% render 'product-card', card_product: recommended_product, instance_id: section.id %}
    {% assign card_count = card_count | plus: 1 %}
    {% if card_count >= section.settings.limit %}{% break %}{% endif %}
  {% endfor %}
{% endcapture %}
<product-recommendations class="section-shell color-{{ section.settings.color_scheme }}" data-url="{{ routes.product_recommendations_url }}" data-product-id="{{ product.id }}" data-section-id="{{ section.id }}" data-intent="{{ section.settings.intent }}" data-limit="{{ section.settings.limit }}">
  {% if card_count > 0 %}
    <div class="container section-content" data-recommendation-content data-recommendation-source="{{ recommendation_source }}">
      {% if section.settings.heading != blank %}<h2 class="product-recommendations__heading">{{ section.settings.heading | escape }}</h2>{% endif %}
      <div class="product-grid">{{ recommendation_cards }}</div>
    </div>
  {% endif %}
</product-recommendations>
{% schema %}
{
  "name": "Product recommendations",
  "enabled_on": { "templates": ["product"] },
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Explore related pieces" },
    { "type": "select", "id": "intent", "label": "Recommendation type", "default": "related", "options": [{"value":"related","label":"Related products"},{"value":"complementary","label":"Complementary products"}] },
    { "type": "range", "id": "limit", "label": "Products to show", "min": 2, "max": 10, "step": 1, "default": 4 },
    { "type": "product_list", "id": "fallback_products", "label": "Fallback products", "limit": 10, "info": "Shown when Shopify has no recommendations. The current product is excluded." },
    { "type": "checkbox", "id": "use_catalog_fallback", "label": "Use catalog when related recommendations are empty", "default": true, "info": "Applies to related products only. Complementary products use Shopify recommendations or your fallback products." },
    { "type": "collection", "id": "fallback_collection", "label": "Fallback collection", "info": "For related products. Leave empty to use the full catalog." },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-light" }
  ],
  "presets": [{ "name": "Product recommendations" }]
}
{% endschema %}
