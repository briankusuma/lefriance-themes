<script src="{{ 'product-features.js' | asset_url }}" defer></script>
<product-recommendations class="section-shell color-{{ section.settings.color_scheme }}" data-url="{{ routes.product_recommendations_url }}" data-product-id="{{ product.id }}" data-section-id="{{ section.id }}" data-intent="{{ section.settings.intent }}" data-limit="{{ section.settings.limit }}">
  {% if recommendations.performed? and recommendations.products_count > 0 %}
    <div class="container section-content" data-recommendation-content>
      <h2 class="product-recommendations__heading">{{ section.settings.heading | escape }}</h2>
      <div class="product-grid">
        {% for recommended_product in recommendations.products %}{% render 'product-card', card_product: recommended_product, instance_id: section.id %}{% endfor %}
      </div>
    </div>
  {% endif %}
</product-recommendations>
{% schema %}
{
  "name": "Product recommendations",
  "enabled_on": { "templates": ["product"] },
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Explore related pieces" },
    { "type": "select", "id": "intent", "label": "Recommendation type", "default": "related", "options": [{"value":"related","label":"Related products"},{"value":"complementary","label":"Complementary products"}] },
    { "type": "range", "id": "limit", "label": "Products to show", "min": 2, "max": 10, "step": 1, "default": 4 },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-light" }
  ],
  "presets": [{ "name": "Product recommendations" }]
}
{% endschema %}
