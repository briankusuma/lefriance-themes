<section class="section-shell color-{{ section.settings.color_scheme }}"><div class="container section-content">
  <h1>{{ 'cart.title' | t }}</h1>
  <p class="commerce-error" data-cart-error role="alert" hidden></p>
  {% render 'cart-content', instance_id: section.id, show_accelerated: true %}
</div></section>
{% schema %}
{"name":"Main cart","settings":[{"type":"color_scheme","id":"color_scheme","label":"Color scheme","default":"scheme-light"}]}
{% endschema %}
