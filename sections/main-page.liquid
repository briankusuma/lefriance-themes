{{ 'section-foundation.css' | asset_url | stylesheet_tag }}
<section class="support-section support-section--page section-shell color-{{ section.settings.color_scheme }}">
  <div class="container section-content">
  <h1>{{ page.title | escape }}</h1>

  <div class="rte">{{ page.content }}</div>
  </div>
</section>

{% schema %}
{
  "name": "Main page",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-light"
    }
  ]
}
{% endschema %}
