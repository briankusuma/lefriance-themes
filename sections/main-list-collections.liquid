{{ 'section-foundation.css' | asset_url | stylesheet_tag }}
<section class="support-section support-section--list-collections section-shell color-{{ section.settings.color_scheme }}">
  <div class="container section-content">
  <h1>{{ 'collections.title' | t }}</h1>

  {% paginate collections by 24 %}
  <div class="collections collections--full">
    {% for collection in collections %}
      <a class="collection-card" href="{{ collection.url }}">
        {% if collection.featured_image %}
          {% render 'image',
            class: 'collection-card__image',
            image: collection.featured_image,
            width: 600,
            height: 600,
            crop: 'center'
          %}
        {% else %}{{ 'collection-1' | placeholder_svg_tag: 'collection-card__placeholder' }}
        {% endif %}

        <div class="collection-card__content">
          <p>{{ collection.title | escape }}</p>

          {% if collection.description %}
            <p>{{ collection.description | strip_html | truncatewords: 15 }}</p>
          {% endif %}
        </div>
      </a>
    {% else %}<p>{{ 'support_sections.no_collections' | t }}</p>
    {% endfor %}
  </div>
  {{ paginate | default_pagination }}
  {% endpaginate %}
  </div>
</section>

{% schema %}
{
  "name": "Main list collections",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-light"
    }
  ]
}
{% endschema %}
