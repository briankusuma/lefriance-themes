{{ 'hero-editorial.css' | asset_url | stylesheet_tag }}
{% liquid
  assign intro_enabled = false
  if section.settings.enable_intro and request.page_type == 'index' and section.index == 1 and section.settings.show_detail_card and section.settings.allow_header_overlay
    if section.settings.intro_pre_image != blank
      assign intro_enabled = true
    elsif section.settings.image == blank and section.settings.use_reference_images
      assign intro_enabled = true
    endif
  endif
  assign hero_loading = 'lazy'
  assign hero_priority = 'auto'
  if section.index == 1
    assign hero_loading = 'eager'
    assign hero_priority = 'high'
  endif
%}
{% if intro_enabled %}<script src="{{ 'hero-intro.js' | asset_url }}" defer></script>{% endif %}
{% style %}
  #shopify-section-{{ section.id }} {
    --hero-height: {{ section.settings.desktop_height }}px;
    --hero-mobile-height: {{ section.settings.mobile_height }}px;
    --hero-image-zoom: {{ section.settings.image_zoom | divided_by: 100.0 }};
    --hero-overlay-opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }};
    --hero-copy-color: {{ section.settings.text_color }};
    --hero-background-color: {{ section.settings.background_color }};
    --hero-overlay-color: {{ section.settings.overlay_color }};
    --hero-intro-background: {{ section.settings.intro_background | default: '#6C7C69' }};
    --hero-intro-text: {{ section.settings.intro_text_color | default: '#FFFFFF' }};
  }
{% endstyle %}
<hero-intro class="editorial-hero section-shell" data-intro-enabled="{{ intro_enabled }}" data-intro-once="{{ section.settings.intro_once }}" data-design-mode="{{ request.design_mode }}"{% if section.settings.allow_header_overlay %} data-header-overlay{% endif %}>
  <div class="editorial-hero__media">
    {% if section.settings.image != blank %}
      <picture>
        {% if section.settings.mobile_image != blank %}<source media="(max-width: 749px)" srcset="{{ section.settings.mobile_image | image_url: width: 900 }}">{% endif %}
        {{ section.settings.image | image_url: width: 2800 | image_tag: widths: '750, 1100, 1535, 2000, 2400, 2800', sizes: '100vw', loading: hero_loading, fetchpriority: hero_priority, alt: section.settings.image.alt, class: 'editorial-hero__photo' }}
      </picture>
    {% elsif section.settings.use_reference_images %}
      <img class="editorial-hero__photo" src="{{ 'hero-furniture.png' | asset_img_url: '1535x' }}" srcset="{{ 'hero-furniture.png' | asset_img_url: '750x' }} 750w, {{ 'hero-furniture.png' | asset_img_url: '1100x' }} 1100w, {{ 'hero-furniture.png' | asset_img_url: '1535x' }} 1535w, {{ 'hero-furniture.png' | asset_img_url: '2400x' }} 2400w" sizes="100vw" width="2400" height="1817" loading="{{ hero_loading }}" fetchpriority="{{ hero_priority }}" alt="{{ 'hero.reference_alt' | t }}">
    {% else %}
      {{ 'lifestyle-1' | placeholder_svg_tag: 'editorial-hero__placeholder' }}
    {% endif %}
  </div>
  {% if intro_enabled %}
    <div class="editorial-hero__pre" aria-hidden="true">
      {% if section.settings.intro_pre_image != blank %}
        {{ section.settings.intro_pre_image | image_url: width: 2400 | image_tag: widths: '750, 1100, 1535, 2000, 2400', sizes: '100vw', loading: 'lazy', alt: '', class: 'editorial-hero__pre-photo' }}
      {% else %}
        <img class="editorial-hero__pre-photo" src="{{ 'hero-motion-pre.jpg' | asset_img_url: '1535x' }}" srcset="{{ 'hero-motion-pre.jpg' | asset_img_url: '750x' }} 750w, {{ 'hero-motion-pre.jpg' | asset_img_url: '1100x' }} 1100w, {{ 'hero-motion-pre.jpg' | asset_img_url: '1535x' }} 1535w" sizes="100vw" width="1280" height="960" loading="lazy" alt="">
      {% endif %}
    </div>
    <div class="editorial-hero__intro-surface" aria-hidden="true"></div>
    <div class="editorial-hero__intro-progress" aria-hidden="true"><span></span></div>
    <button class="editorial-hero__intro-skip" type="button" data-intro-skip hidden>{{ 'hero.skip_intro' | t }}</button>
  {% endif %}
  <div class="editorial-hero__shade" aria-hidden="true"></div>
  <div class="editorial-hero__content container">
    <div class="editorial-hero__title-frame">
    <div class="editorial-hero__title">
    {% if section.settings.wordmark != blank %}
      {{ section.settings.wordmark | image_url: width: 2400 | image_tag: widths: '750, 1100, 1600, 2400', sizes: '93vw', alt: section.settings.heading, class: 'editorial-hero__wordmark' }}
      <h1 class="visually-hidden">{{ section.settings.heading | default: shop.name | escape }}</h1>
    {% elsif section.settings.use_reference_wordmark %}
      <img class="editorial-hero__wordmark" src="{{ 'le-friance-wordmark.svg' | asset_url }}" width="1433" height="404" alt="{{ section.settings.heading | default: shop.name | escape }}">
      <h1 class="visually-hidden">{{ section.settings.heading | default: shop.name | escape }}</h1>
    {% else %}
      <h1 class="editorial-hero__heading">{{ section.settings.heading | default: shop.name | escape }}</h1>
    {% endif %}
    </div>
    <span class="editorial-hero__reveal-line" aria-hidden="true"></span>
    </div>
    {% if section.settings.show_detail_card %}
      <div class="editorial-hero__detail">
        <div class="editorial-hero__detail-content">
        {% if section.settings.detail_link != blank %}<a href="{{ section.settings.detail_link }}" aria-label="{{ section.settings.detail_link_label | default: section.settings.heading | default: shop.name | escape }}">{% endif %}
        <div class="editorial-hero__card">
          {% if section.settings.detail_image != blank %}
            {{ section.settings.detail_image | image_url: width: 400 | image_tag: widths: '160, 240, 400', sizes: '150px', loading: hero_loading, alt: section.settings.detail_image.alt }}
          {% elsif section.settings.use_reference_images %}
            <img src="{{ 'hero-detail.png' | asset_img_url: '300x' }}" srcset="{{ 'hero-detail.png' | asset_img_url: '160x' }} 160w, {{ 'hero-detail.png' | asset_img_url: '300x' }} 300w" sizes="150px" width="960" height="1200" loading="{{ hero_loading }}" alt="{{ 'hero.detail_alt' | t }}">
          {% else %}{{ 'product-1' | placeholder_svg_tag }}
          {% endif %}
          <span class="editorial-hero__card-blur" aria-hidden="true"></span>
        </div>
        {% if section.settings.detail_link != blank %}</a>{% endif %}
        {% if section.settings.body != blank or section.settings.body_muted != blank %}
          <div class="editorial-hero__body rte">
            {% if section.settings.body != blank %}<span class="editorial-hero__body-primary">{{ section.settings.body }}</span>{% endif %}
            {% if section.settings.body_muted != blank %}<span class="editorial-hero__body-muted">{{ section.settings.body_muted | escape }}</span>{% endif %}
            {% if intro_enabled %}<span class="editorial-hero__intro-copy" aria-hidden="true">{{ section.settings.body | strip_html }} {{ section.settings.body_muted | escape }}</span>{% endif %}
          </div>
        {% endif %}
        </div>
      </div>
    {% elsif section.settings.body != blank %}<div class="editorial-hero__body editorial-hero__body--alone rte">{{ section.settings.body }}</div>{% endif %}
  </div>
</hero-intro>

{% schema %}
{
  "name": "Editorial hero",
  "tag": "section",
  "disabled_on": {
    "groups": [
      "header",
      "footer"
    ]
  },
  "settings": [
    {
      "type": "header",
      "content": "Intro animation"
    },
    {
      "type": "checkbox",
      "id": "enable_intro",
      "label": "Enable intro animation",
      "default": false,
      "info": "Runs on the first home page hero with a detail card and header overlay. Reduced motion and the theme editor show the final hero."
    },
    {
      "type": "checkbox",
      "id": "intro_once",
      "label": "Play once per session",
      "default": true
    },
    {
      "type": "image_picker",
      "id": "intro_pre_image",
      "label": "Empty room image",
      "info": "Match the composition of the furnished hero image. Required when using custom hero photography."
    },
    {
      "type": "color",
      "id": "intro_background",
      "label": "Intro background",
      "default": "#6C7C69"
    },
    {
      "type": "color",
      "id": "intro_text_color",
      "label": "Intro text",
      "default": "#FFFFFF"
    },
    {
      "type": "header",
      "content": "Images"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Desktop image"
    },
    {
      "type": "image_picker",
      "id": "mobile_image",
      "label": "Mobile image"
    },
    {
      "type": "checkbox",
      "id": "use_reference_images",
      "label": "Use reference furniture images when empty",
      "default": false
    },
    {
      "type": "range",
      "id": "image_zoom",
      "label": "Image zoom",
      "min": 100,
      "max": 125,
      "step": 1,
      "default": 106,
      "unit": "%"
    },
    {
      "type": "header",
      "content": "Heading"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Introduce your furniture collection"
    },
    {
      "type": "image_picker",
      "id": "wordmark",
      "label": "Display wordmark"
    },
    {
      "type": "checkbox",
      "id": "use_reference_wordmark",
      "label": "Use LE FRIANCE reference wordmark",
      "default": false
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "Body text",
      "default": "<p>Share what makes your collection special.</p>"
    },
    {
      "type": "text",
      "id": "body_muted",
      "label": "Muted body text",
      "info": "Appears at lower opacity after the body text."
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#3A322B"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#FFFFFF"
    },
    {
      "type": "header",
      "content": "Detail card"
    },
    {
      "type": "checkbox",
      "id": "show_detail_card",
      "label": "Show detail card",
      "default": true
    },
    {
      "type": "image_picker",
      "id": "detail_image",
      "label": "Detail image"
    },
    {
      "type": "url",
      "id": "detail_link",
      "label": "Detail link"
    },
    {
      "type": "text",
      "id": "detail_link_label",
      "label": "Detail link label"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "number",
      "id": "desktop_height",
      "label": "Desktop maximum height",
      "default": 1092
    },
    {
      "type": "range",
      "id": "mobile_height",
      "label": "Mobile height",
      "min": 480,
      "max": 900,
      "step": 20,
      "default": 680,
      "unit": "px"
    },
    {
      "type": "checkbox",
      "id": "allow_header_overlay",
      "label": "Allow header overlay",
      "default": true
    },
    {
      "type": "color",
      "id": "overlay_color",
      "label": "Overlay",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Readability overlay",
      "min": 0,
      "max": 80,
      "step": 5,
      "default": 60,
      "unit": "%",
      "info": "Keep text readable over the selected image. Check contrast when reducing this value."
    }
  ],
  "presets": [
    {
      "name": "Editorial hero"
    }
  ]
}
{% endschema %}
