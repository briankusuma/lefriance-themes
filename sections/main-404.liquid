{{ 'section-foundation.css' | asset_url | stylesheet_tag }}
<section class="support-section support-section--404 section-shell color-{{ section.settings.color_scheme }}">
  <div class="container section-content">
  <h1>{{ '404.title' | t }}</h1>

  <p>
    {{ '404.not_found' | t }}
  </p>

  <a class="button" href="{{ routes.all_products_collection_url }}">
    {{ '404.back_to_shopping' | t }}
  </a>
  </div>
</section>

{% schema %}
{
  "name": "Main 404",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-light"
    }
  ]
}
{% endschema %}
