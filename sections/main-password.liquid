{% comment %}Skeleton baseline migrated to JSON sections in T00. Full page features are a later milestone.{% endcomment %}
 <div class="page-shell">
  <h1>{{ 'password.title' | t }}</h1>

  {% if shop.password_message %}
    <p>{{ shop.password_message }}</p>
  {% endif %}

  {% form 'storefront_password' %}
    {% if form.errors %}
      {{ form.errors | default_errors }}
    {% endif %}

    <label for="password-input-{{ section.id }}">
      {{ 'password.password' | t }}
    </label>

    <input type="password" name="password" id="password-input-{{ section.id }}">

    <button type="submit">
      {{ 'password.enter' | t }}
    </button>
  {% endform %}
</div>

{% schema %}
{
  "name": "Main password",
  "settings": []
}
{% endschema %}
