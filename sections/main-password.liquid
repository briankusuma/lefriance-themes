{{ 'section-foundation.css' | asset_url | stylesheet_tag }}
<section class="support-section support-section--password section-shell color-{{ section.settings.color_scheme }}">
  <div class="container section-content">
  <p class="support-eyebrow">{{ shop.name | escape }}</p>
  <h1>{{ 'password.title' | t }}</h1>

  {% if shop.password_message %}
    <p>{{ shop.password_message }}</p>
  {% endif %}

  {% form 'storefront_password' %}
    {% if form.errors %}
      {{ form.errors | default_errors }}
    {% endif %}

    <label for="password-input-{{ section.id }}">
      {{ 'password.password' | t }}
    </label>

    <input type="password" autocomplete="current-password" required name="password" id="password-input-{{ section.id }}">

    <button type="submit">
      {{ 'password.enter' | t }}
    </button>
  {% endform %}
  </div>
</section>

{% schema %}
{
  "name": "Main password",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-light"
    }
  ]
}
{% endschema %}
