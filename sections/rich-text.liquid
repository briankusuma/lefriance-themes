<section class="section-shell color-{{ section.settings.color_scheme }}"><div class="{% if section.settings.width == 'container' %}container{% else %}section-content--full{% endif %} section-content"><h2>{{ section.settings.heading | escape }}</h2><div class="rte">{{ section.settings.body }}</div>{% if section.settings.button_link != blank and section.settings.button_label != blank %}<a class="button" href="{{ section.settings.button_link }}">{{ section.settings.button_label | escape }}</a>{% endif %}</div></section>

{% schema %}
{
  "name": "Rich text",
  "disabled_on": {
    "groups": [
      "header",
      "footer"
    ]
  },
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Tell your story"
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "Body text",
      "default": "<p>Share your approach to materials, craftsmanship, and furniture.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "select",
      "id": "width",
      "label": "Content width",
      "options": [
        {
          "value": "container",
          "label": "Container"
        },
        {
          "value": "full",
          "label": "Full width"
        }
      ],
      "default": "container"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-light"
    }
  ],
  "presets": [
    {
      "name": "Rich text"
    }
  ]
}
{% endschema %}
