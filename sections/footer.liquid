{{ 'footer-editorial.css' | asset_url | stylesheet_tag }}
<script src="{{ 'footer-gallery.js' | asset_url }}" defer></script>
{% assign media_blocks = section.blocks | where: 'type', 'media' %}
<footer class="editorial-footer section-shell color-{{ section.settings.color_scheme }}" style="--footer-ornament-color: {{ section.settings.ornament_color | default: '#5B5148' }};">
  <div class="container">
    <div class="editorial-footer__top">
      <div class="editorial-footer__identity">
        <div class="editorial-footer__thumbnails">
          {% for index in (1..2) %}
            {% liquid
              assign thumbnail = section.settings.thumbnail_one
              assign reference = 'collage-sofa.png'
              if index == 2
                assign thumbnail = section.settings.thumbnail_two
                assign reference = 'collage-console.png'
              endif
            %}
            {% if thumbnail != blank or section.settings.use_reference_images %}
              <div class="editorial-footer__thumbnail{% if thumbnail == blank and index == 1 %} editorial-footer__thumbnail--sofa{% endif %}">
                {% if thumbnail != blank %}
                  {{ thumbnail | image_url: width: 300 | image_tag: widths: '120, 240, 300', sizes: '116px', loading: 'lazy', alt: thumbnail.alt }}
                {% else %}
                  <img src="{{ reference | asset_img_url: '480x' }}" width="960" height="1200" alt="" loading="lazy">
                {% endif %}
              </div>
            {% endif %}
          {% endfor %}
        </div>
        <div>
          <div class="editorial-footer__socials">
            {% if section.settings.facebook_url != blank %}<a href="{{ section.settings.facebook_url }}" aria-label="Facebook"><img src="{{ 'footer-facebook.svg' | asset_url }}" width="34.1111" height="34.1111" alt="" loading="lazy"></a>{% endif %}
            {% if section.settings.x_url != blank %}<a href="{{ section.settings.x_url }}" aria-label="X"><img src="{{ 'footer-x.svg' | asset_url }}" width="34.1111" height="34.1111" alt="" loading="lazy"></a>{% endif %}
            {% if section.settings.linkedin_url != blank %}<a href="{{ section.settings.linkedin_url }}" aria-label="LinkedIn"><img src="{{ 'footer-linkedin.svg' | asset_url }}" width="34.1111" height="34.1111" alt="" loading="lazy"></a>{% endif %}
          </div>
          <div class="editorial-footer__social-copy rte">{{ section.settings.social_text }}</div>
        </div>
      </div>
      <div class="editorial-footer__navigation">
        {% if section.settings.menu.links.size > 0 %}
          <nav aria-label="{{ 'editorial_footer.menu' | t | escape }}"><ul>
            {% for link in section.settings.menu.links %}
              <li><a href="{{ link.url }}">{{ link.title | escape }}</a>
                {% if link.links.size > 0 %}<ul>{% for child in link.links %}<li><a href="{{ child.url }}">{{ child.title | escape }}</a>{% if child.links.size > 0 %}<ul>{% for grandchild in child.links %}<li><a href="{{ grandchild.url }}">{{ grandchild.title | escape }}</a></li>{% endfor %}</ul>{% endif %}</li>{% endfor %}</ul>{% endif %}
              </li>
            {% endfor %}
          </ul></nav>
        {% endif %}
        <div class="editorial-footer__studio-copy rte">{{ section.settings.studio_text }}</div>
      </div>
      {% if media_blocks.size > 0 or section.settings.use_reference_images %}
        <footer-gallery class="editorial-footer__gallery">
          {% for block in media_blocks %}
            <div class="editorial-footer__slide" id="FooterSlide-{{ section.id }}-{{ block.id }}" data-footer-slide {{ block.shopify_attributes }}>
              {% if block.settings.image != blank %}
                {{ block.settings.image | image_url: width: 1200 | image_tag: widths: '360, 540, 800, 1200', sizes: '(min-width: 990px) 34vw, 90vw', loading: 'lazy', alt: block.settings.image.alt }}
              {% else %}{{ 'image' | placeholder_svg_tag }}{% endif %}
              {% if block.settings.caption != blank %}<div class="editorial-footer__image-caption rte">{{ block.settings.caption }}</div>{% endif %}
            </div>
          {% else %}
            <div class="editorial-footer__slide">
              <img src="{{ 'material-story-room.png' | asset_img_url: '960x' }}" srcset="{{ 'material-story-room.png' | asset_img_url: '360x' }} 360w, {{ 'material-story-room.png' | asset_img_url: '680x' }} 680w, {{ 'material-story-room.png' | asset_img_url: '960x' }} 960w" sizes="(min-width: 990px) 34vw, 90vw" width="960" height="1200" alt="{{ 'editorial_footer.studio_image' | t | escape }}" loading="lazy">
              <div class="editorial-footer__image-caption rte">{{ section.settings.image_caption }}</div>
            </div>
          {% endfor %}
          {% if media_blocks.size > 1 %}
            <div class="editorial-footer__dots" role="group" aria-label="{{ 'editorial_footer.photos' | t | escape }}" data-footer-controls hidden>
              {% for block in media_blocks %}<button type="button" data-footer-select="{{ forloop.index0 }}" aria-controls="FooterSlide-{{ section.id }}-{{ block.id }}" aria-label="{{ 'editorial_footer.show_photo' | t: number: forloop.index | escape }}" aria-pressed="false"><span aria-hidden="true"></span><img src="{{ 'material-story-active.svg' | asset_url }}" width="12.7917" height="12.7917" alt="" loading="lazy"></button>{% endfor %}
            </div>
          {% endif %}
        </footer-gallery>
      {% endif %}
    </div>
    {% for block in section.blocks %}
      {% if block.type == 'newsletter' %}
        {% assign form_id = 'FooterNewsletter-' | append: section.id | append: '-' | append: block.id %}
        <div class="editorial-footer__newsletter" {{ block.shopify_attributes }}>
          <div class="editorial-footer__brand-copy rte">{{ section.settings.brand_text }}</div>
          <h2>{{ block.settings.heading | escape }}</h2>
          {% form 'customer', id: form_id, class: 'editorial-footer__form' %}
            <input type="hidden" name="contact[tags]" value="newsletter">
            <label for="{{ form_id }}-Email">{{ block.settings.email_label | escape }}</label>
            <div class="editorial-footer__email-row">
              <input type="email" id="{{ form_id }}-Email" name="contact[email]" value="{{ form.email | escape }}" autocomplete="email" autocorrect="off" autocapitalize="off" required{% if form.errors %} aria-invalid="true" aria-describedby="{{ form_id }}-Error"{% endif %}>
              <button type="submit">{{ block.settings.button_label | escape }}</button>
            </div>
            {% if block.settings.help_text != blank %}<div class="editorial-footer__help rte">{{ block.settings.help_text }}</div>{% endif %}
            {% if form.errors %}<div id="{{ form_id }}-Error" role="alert">{{ form.errors | default_errors }}</div>{% endif %}
            {% if form.posted_successfully? %}<p role="status">{{ 'editorial_footer.subscribed' | t }}</p>{% endif %}
          {% endform %}
        </div>
      {% endif %}
    {% endfor %}
    <div class="editorial-footer__wordmark">
      {% if section.settings.wordmark != blank %}
        {{ section.settings.wordmark | image_url: width: 2400 | image_tag: widths: '480, 960, 1440, 2400', sizes: '93vw', loading: 'lazy', alt: shop.name }}
      {% elsif section.settings.use_reference_wordmark %}
        <img src="{{ 'le-friance-wordmark.svg' | asset_url }}" width="1433" height="404" alt="{{ shop.name | escape }}" loading="lazy">
      {% else %}<p>{{ shop.name | escape }}</p>{% endif %}
    </div>
    <div class="editorial-footer__bottom">
      <small>&copy; {{ 'now' | date: '%Y' }} {{ shop.name | link_to: routes.root_url }}, {{ powered_by_link }}</small>
      <ul>{% for policy in shop.policies %}{% if policy != blank %}<li><a href="{{ policy.url }}">{{ policy.title | escape }}</a></li>{% endif %}{% endfor %}</ul>
      {% if section.settings.show_payment_icons %}<div class="editorial-footer__payments">{% for type in shop.enabled_payment_types %}{{ type | payment_type_svg_tag }}{% endfor %}</div>{% endif %}
    </div>
  </div>
</footer>
{% schema %}
{
  "name": "Footer",
  "limit": 1,
  "enabled_on": { "groups": ["footer"] },
  "max_blocks": 7,
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-footer" },
    { "type": "color", "id": "ornament_color", "label": "Ornament color", "default": "#5B5148" },
    { "type": "link_list", "id": "menu", "label": "Footer menu", "default": "footer" },
    { "type": "image_picker", "id": "thumbnail_one", "label": "First thumbnail" },
    { "type": "image_picker", "id": "thumbnail_two", "label": "Second thumbnail" },
    { "type": "checkbox", "id": "use_reference_images", "label": "Use reference images when empty", "default": false },
    { "type": "richtext", "id": "social_text", "label": "Social introduction" },
    { "type": "url", "id": "facebook_url", "label": "Facebook link" },
    { "type": "url", "id": "x_url", "label": "X link" },
    { "type": "url", "id": "linkedin_url", "label": "LinkedIn link" },
    { "type": "richtext", "id": "studio_text", "label": "Studio text" },
    { "type": "richtext", "id": "brand_text", "label": "Brand text" },
    { "type": "richtext", "id": "image_caption", "label": "Reference image caption" },
    { "type": "image_picker", "id": "wordmark", "label": "Display wordmark" },
    { "type": "checkbox", "id": "use_reference_wordmark", "label": "Use LE FRIANCE reference wordmark", "default": false },
    { "type": "checkbox", "id": "show_payment_icons", "label": "Show payment icons", "default": true }
  ],
  "blocks": [
    { "type": "newsletter", "name": "Newsletter", "limit": 1, "settings": [
      { "type": "text", "id": "heading", "label": "Heading", "default": "Subscribe for collection updates" },
      { "type": "text", "id": "email_label", "label": "Email label", "default": "Your email" },
      { "type": "text", "id": "button_label", "label": "Button label", "default": "Subscribe" },
      { "type": "richtext", "id": "help_text", "label": "Help text" }
    ] },
    { "type": "media", "name": "Studio photo", "limit": 6, "settings": [
      { "type": "image_picker", "id": "image", "label": "Image" },
      { "type": "richtext", "id": "caption", "label": "Caption" }
    ] }
  ],
  "presets": [{ "name": "Footer", "blocks": [{ "type": "newsletter" }] }]
}
{% endschema %}
