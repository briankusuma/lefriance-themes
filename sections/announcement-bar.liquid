{% if section.settings.text != blank %}<aside class="announcement-bar color-{{ section.settings.color_scheme }}"><div class="container">{% if section.settings.link != blank %}<a href="{{ section.settings.link }}">{{ section.settings.text | escape }}</a>{% else %}<p>{{ section.settings.text | escape }}</p>{% endif %}</div></aside>{% endif %}
{% stylesheet %}.announcement-bar { padding-block: .6rem; text-align: center; font-size: var(--text-caption); }{% endstylesheet %}

{% schema %}
{
  "name": "Announcement bar",
  "enabled_on": {
    "groups": [
      "header"
    ]
  },
  "settings": [
    {
      "type": "text",
      "id": "text",
      "label": "Text",
      "default": "Share an announcement with your customers"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-dark"
    }
  ],
  "presets": [
    {
      "name": "Announcement bar"
    }
  ]
}
{% endschema %}
