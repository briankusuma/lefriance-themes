{{ 'section-foundation.css' | asset_url | stylesheet_tag }}
<section class="support-section support-section--blog section-shell color-{{ section.settings.color_scheme }}">
  <div class="container section-content">
  <h1>{{ blog.title | escape }}</h1>

  {% paginate blog.articles by 5 %}
    <div class="support-journal">
    {% for article in blog.articles %}
      <article class="support-story">
        {% if article.image %}
          <a href="{{ article.url }}" aria-label="{{ article.title | escape }}">{{ article.image | image_url: width: 1000 | image_tag: widths: '320, 600, 1000', sizes: '(min-width: 990px) 33vw, 90vw', alt: article.image.alt, loading: 'lazy' }}</a>
        {% endif %}
        <h2>
          {{ article.title | escape | link_to: article.url }}
        </h2>
        {% assign date = article.published_at | time_tag: format: 'date' %}
        <p>{{ 'blog.article_metadata_html' | t: date: date, author: article.author }}</p>
        <p>{{ article.excerpt_or_content | strip_html | truncatewords: 40 }}</p>
      </article>
    {% else %}<p>{{ 'support_sections.no_articles' | t }}</p>
    {% endfor %}
    </div>

    {%- if paginate.pages > 1 -%}
      {{- paginate | default_pagination -}}
    {%- endif -%}
  {% endpaginate %}
  </div>
</section>

{% schema %}
{
  "name": "Main blog",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-light"
    }
  ]
}
{% endschema %}
