{{ 'section-foundation.css' | asset_url | stylesheet_tag }}
<section class="support-section support-section--newsletter section-shell color-{{ section.settings.color_scheme }}"><div class="container section-content">
  <h2>{{ section.settings.heading | escape }}</h2><div class="rte">{{ section.settings.body }}</div>
  {% assign newsletter_id = 'Newsletter-' | append: section.id %}
  {% form 'customer', id: newsletter_id %}
    <input type="hidden" name="contact[tags]" value="newsletter">
    {% if form.posted_successfully? %}<p role="status">{{ 'commerce.newsletter_success' | t }}</p>{% endif %}
    {% if form.errors %}<div role="alert">{{ form.errors | default_errors }}</div>{% endif %}
    <label for="Email-{{ section.id }}">{{ 'commerce.email' | t }}</label>
    <input id="Email-{{ section.id }}" type="email" name="contact[email]" value="{{ form.email | escape }}" autocomplete="email" autocorrect="off" autocapitalize="off" required>
    <button type="submit">{{ section.settings.button_label | escape }}</button>
  {% endform %}
</div></section>

{% schema %}
{
  "name": "Newsletter",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Invite customers to subscribe"
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "Body text",
      "default": "<p>Explain the updates subscribers can expect.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Subscribe"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-light"
    }
  ],
  "presets": [
    {
      "name": "Newsletter"
    }
  ]
}
{% endschema %}
