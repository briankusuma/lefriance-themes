<script src="{{ 'product.js' | asset_url }}" defer></script>
<section class="section-shell color-{{ section.settings.color_scheme }}"><div class="container section-content product-layout">
  <div class="product-gallery">
    {% for media in product.media %}<div id="ProductMedia-{{ section.id }}-{{ media.id }}" data-product-media="{{ media.id }}">{% if media.media_type == 'image' %}{% assign media_loading = 'lazy' %}{% if forloop.first %}{% assign media_loading = 'eager' %}{% endif %}{{ media | image_url: width: 1800 | image_tag: widths: '400, 800, 1200, 1800', sizes: '(min-width: 990px) 55vw, 100vw', loading: media_loading, alt: media.alt }}{% else %}{{ media | media_tag: image_size: '1200x', controls: true }}{% endif %}</div>{% endfor %}
  </div>
  <div class="product-details">
    {% for block in section.blocks %}<div {{ block.shopify_attributes }}>{% case block.type %}
      {% when 'title' %}<h1>{{ product.title | escape }}</h1>
      {% when 'colors' %}{% render 'product-color-metafield', color_product: product, show_labels: true %}
      {% when 'buy_buttons' %}{% render 'product-form', product: product, instance_id: section.id, accelerated: block.settings.accelerated %}
      {% when 'description' %}<div class="rte">{{ product.description }}</div>
      {% when '@app' %}{% render block %}
      {% when 'custom_liquid' %}{{ block.settings.code }}
    {% endcase %}</div>{% endfor %}
  </div>
</div></section>
<script type="application/ld+json">{{ product | structured_data }}</script>

{% schema %}
{
  "name": "Main product",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-light"
    }
  ],
  "blocks": [
    {
      "type": "colors",
      "name": "Colors",
      "limit": 1
    },
    {
      "type": "title",
      "name": "Title",
      "limit": 1
    },
    {
      "type": "buy_buttons",
      "name": "Product form",
      "limit": 1,
      "settings": [
        {
          "type": "checkbox",
          "id": "accelerated",
          "label": "Show accelerated checkout",
          "default": true
        }
      ]
    },
    {
      "type": "description",
      "name": "Description",
      "limit": 1
    },
    {
      "type": "@app"
    },
    {
      "type": "custom_liquid",
      "name": "Custom Liquid",
      "settings": [
        {
          "type": "liquid",
          "id": "code",
          "label": "Liquid code"
        }
      ]
    }
  ]
}
{% endschema %}
