<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    {% # Inlined CSS Variables %}
    {% render 'css-variables' %}

    {% comment %}
      Font preloading:
      1. Preconnect to font CDN for faster connection
      2. Preload only the critical font variant (base weight)
      3. Additional variants load on-demand via @font-face
    {% endcomment %}
    {% if settings.type_primary_font.family != blank and settings.type_primary_font.system? == false %}

      {% comment %} Preload the base font variant for initial page render {% endcomment %}
      {{ settings.type_primary_font | font_url | preload_tag: as: 'font', crossorigin: 'anonymous' }}
    {% endif %}

    {% # Load and preload the critical CSS %}
    {{ 'critical.css' | asset_url | stylesheet_tag: preload: true }}
    {{ 'base.css' | asset_url | stylesheet_tag }}
    {{ 'foundation.css' | asset_url | stylesheet_tag }}
    {{ 'commerce.css' | asset_url | stylesheet_tag }}
    <script src="{{ 'commerce.js' | asset_url }}" defer></script>

    {% # Social, title, etc. %}
    {% render 'meta-tags' %}

    {{ content_for_header }}
  </head>

  <body data-cart-updated-message="{{ 'commerce.cart_updated_label' | t | escape }}" data-cart-type="{{ settings.cart_type }}" data-cart-url="{{ routes.cart_url }}" data-cart-add-url="{{ routes.cart_add_url }}" data-cart-change-url="{{ routes.cart_change_url }}" data-cart-update-url="{{ routes.cart_update_url }}" data-cart-error-message="{{ 'commerce.cart_error' | t | escape }}">
    <a class="skip-link" href="#MainContent">{{ 'general.skip_to_content' | t }}</a>
    {% sections 'header-group' %}

    <main id="MainContent" tabindex="-1">
      {{ content_for_layout }}
    </main>

    {% sections 'footer-group' %}
    {% if settings.cart_type != 'page' and request.page_type != 'cart' %}{% section 'cart-drawer' %}{% endif %}
    <p class="visually-hidden" role="status" data-cart-status></p>
  </body>
</html>
