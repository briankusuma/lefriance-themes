{% doc %}
  Render a menu with native disclosures and up to three Shopify menu levels.
  @param {linklist} menu - Merchant selected menu.
{% enddoc %}
<ul class="site-header__menu-list" role="list">
  {% for link in menu.links %}
    <li>
      {% if link.links != blank %}
        <details class="site-header__submenu">
          <summary>{{ link.title | escape }}</summary>
          <div class="site-header__submenu-panel">
            <a href="{{ link.url }}"{% if link.current %} aria-current="page"{% endif %}>{{ link.title | escape }}</a>
            <ul role="list">
              {% for child in link.links %}
                <li>
                  {% if child.links != blank %}
                    <details>
                      <summary>{{ child.title | escape }}</summary>
                      <ul role="list">
                        <li><a href="{{ child.url }}"{% if child.current %} aria-current="page"{% endif %}>{{ child.title | escape }}</a></li>
                        {% for grandchild in child.links %}
                          <li><a href="{{ grandchild.url }}"{% if grandchild.current %} aria-current="page"{% endif %}>{{ grandchild.title | escape }}</a></li>
                        {% endfor %}
                      </ul>
                    </details>
                  {% else %}
                    <a href="{{ child.url }}"{% if child.current %} aria-current="page"{% endif %}>{{ child.title | escape }}</a>
                  {% endif %}
                </li>
              {% endfor %}
            </ul>
          </div>
        </details>
      {% else %}
        <a href="{{ link.url }}"{% if link.current %} aria-current="page"{% endif %}>{{ link.title | escape }}</a>
      {% endif %}
    </li>
  {% endfor %}
</ul>
