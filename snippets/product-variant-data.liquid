{% doc %}
  Variant data shared by the editable product controls.
  @param {product} product - The product.
{% enddoc %}
<script type="application/json" data-product-variants>[
  {% if product.variants_count > 250 %}
    {% if product.selected_or_first_available_variant %}{% render 'product-variant-json', variant: product.selected_or_first_available_variant %}{% endif %}
  {% else %}
    {% for variant in product.variants %}{% render 'product-variant-json', variant: variant %}{% unless forloop.last %},{% endunless %}{% endfor %}
  {% endif %}
]</script>
