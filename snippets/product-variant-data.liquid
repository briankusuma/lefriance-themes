{% doc %}
  Variant data shared by the editable product controls.
  @param {product} product - The product.
{% enddoc %}
<script type="application/json" data-product-variants>[
    {% for variant in product.variants %}{% capture price_markup %}{% render 'price', item: variant %}{% endcapture %}
      {"id":{{ variant.id | json }},"available":{{ variant.available | json }},"options":{{ variant.options | json }},"price":{{ price_markup | json }},"media":{{ variant.featured_media.id | default: 0 | json }},"min":{{ variant.quantity_rule.min | default: 1 | json }},"max":{{ variant.quantity_rule.max | default: 0 | json }},"step":{{ variant.quantity_rule.increment | default: 1 | json }},"plans":[{% for allocation in variant.selling_plan_allocations %}{% capture plan_price %}{{ allocation.price | money_with_currency }}{% endcapture %}{"id":{{ allocation.selling_plan.id | json }},"price":{{ plan_price | json }}}{% unless forloop.last %},{% endunless %}{% endfor %}]}{% unless forloop.last %},{% endunless %}
    {% endfor %}
  ]</script>
