{% style %}
  {% assign body_font = settings.type_primary_font %}
  {% assign heading_font = settings.type_heading_font %}
  {{ body_font | font_face: font_display: 'swap' }}
  {{ body_font | font_modify: 'weight', 'bold' | font_face: font_display: 'swap' }}
  {{ body_font | font_modify: 'style', 'italic' | font_face: font_display: 'swap' }}
  {{ body_font | font_modify: 'weight', 'bold' | font_modify: 'style', 'italic' | font_face: font_display: 'swap' }}
  {% unless heading_font == body_font %}
    {{ heading_font | font_face: font_display: 'swap' }}
    {{ heading_font | font_modify: 'weight', 'bold' | font_face: font_display: 'swap' }}
    {{ heading_font | font_modify: 'style', 'italic' | font_face: font_display: 'swap' }}
    {{ heading_font | font_modify: 'weight', 'bold' | font_modify: 'style', 'italic' | font_face: font_display: 'swap' }}
  {% endunless %}
  :root {
    --font-primary--family: {{ body_font.family }}, {{ body_font.fallback_families }};
    --font-primary--style: {{ body_font.style }};
    --font-primary--weight: {{ body_font.weight }};
    --font-heading--family: {{ heading_font.family }}, {{ heading_font.fallback_families }};
    --font-heading--style: {{ heading_font.style }};
    --font-heading--weight: {{ heading_font.weight }};
    --page-width: {{ settings.max_page_width }};
    --page-margin: clamp(1.25rem, 3.333vw, {{ settings.min_page_margin }}px);
    --color-background: {{ settings.default_color_scheme.settings.background | default: '#F8F0E8' }};
    --color-foreground: {{ settings.default_color_scheme.settings.text | default: '#171513' }};
    --color-button: {{ settings.default_color_scheme.settings.button | default: '#3A322B' }};
    --color-button-label: {{ settings.default_color_scheme.settings.button_label | default: '#FFFFFF' }};
    --style-border-radius-inputs: {{ settings.input_corner_radius }}px;
    --radius-card: 0.66625rem;
    --space-unit: 0.2665rem;
    --grid-gap: 1.332rem;
    --text-caption: 0.933rem;
    --text-body: 1.066rem;
    --text-lead: 1.199rem;
    --text-card: 1.332rem;
    --text-heading: clamp(2rem, 3.333vw, 3.198rem);
  }
  {% for scheme in settings.color_schemes %}
    .color-{{ scheme.id }} {
      --color-background: {{ scheme.settings.background }};
      --color-foreground: {{ scheme.settings.text }};
      --color-button: {{ scheme.settings.button }};
      --color-button-label: {{ scheme.settings.button_label }};
      --color-border: {{ scheme.settings.border }};
      background-color: var(--color-background);
      color: var(--color-foreground);
    }
  {% endfor %}
{% endstyle %}
