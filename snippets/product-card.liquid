{% doc %}
  A reusable product card using real catalog data and global settings.
  @param {product} card_product - Product to display.
  @param {string} instance_id - Unique card placement.
  @param {boolean} [editorial] - Use the featured collection card layout.
  @param {boolean} [disable_quick_add] - Keep the card as product navigation only.
{% enddoc %}
{% capture card_action %}
  {% if settings.card_quick_add and disable_quick_add != true %}
    {% if card_product.has_only_default_variant and card_product.available and card_product.requires_selling_plan == false %}
      {% assign card_form_id = 'QuickAdd-' | append: instance_id | append: '-' | append: card_product.id %}
      {% form 'product', card_product, id: card_form_id, data-product-form: '' %}<input type="hidden" name="id" value="{{ card_product.selected_or_first_available_variant.id }}"><button type="submit">{{ 'commerce.add_to_cart' | t }}</button><p data-product-error role="alert" hidden></p>{% endform %}
    {% else %}<a href="{{ card_product.url }}">{{ 'commerce.choose_options' | t }}</a>{% endif %}
  {% endif %}
{% endcapture %}
{% assign card_action = card_action | strip %}
<article class="product-card{% if editorial %} product-card--editorial{% else %} product-card--catalog{% endif %}">
  <a class="product-card__media" href="{{ card_product.url }}" aria-label="{{ card_product.title | escape }}">
    {% if card_product.featured_image %}{{ card_product.featured_image | image_url: width: 900 | image_tag: widths: '240, 400, 600, 900', sizes: '(min-width: 1100px) 25vw, 50vw', loading: 'lazy', alt: card_product.featured_image.alt }}{% else %}{{ 'product-1' | placeholder_svg_tag }}{% endif %}
    {% if settings.card_secondary_image and card_product.images[1] %}{{ card_product.images[1] | image_url: width: 900 | image_tag: widths: '240, 400, 600, 900', sizes: '(min-width: 1100px) 25vw, 50vw', loading: 'lazy', alt: '', class: 'product-card__secondary' }}{% endif %}
    {% if settings.card_show_badges %}{% unless card_product.available %}<span class="product-card__badge">{{ 'commerce.sold_out' | t }}</span>{% else %}{% if card_product.compare_at_price > card_product.price %}<span class="product-card__badge">{{ 'commerce.sale' | t }}</span>{% endif %}{% endunless %}{% endif %}
  </a>
  {% if settings.card_show_vendor %}<small>{{ card_product.vendor | escape }}</small>{% endif %}
  <h3><a href="{{ card_product.url }}">{{ card_product.title | escape }}</a></h3>
  <div class="product-card__meta">
    {% render 'price', item: card_product %}
    {% if settings.card_show_swatches %}
      <div class="product-card__swatches">
        {% assign has_option_swatches = false %}
        {% for option in card_product.options_with_values %}
          {% for value in option.values %}
            {% assign swatch_url = value.variant.url | default: value.product_url %}
            {% assign swatch_name = value.name | default: value %}
            {% if value.swatch and swatch_url != blank %}
              {% if value.swatch.image != blank or value.swatch.color != blank %}
              {% assign has_option_swatches = true %}
              <a class="product-swatch" href="{{ swatch_url }}" aria-label="{{ option.name | escape }}: {{ swatch_name | escape }}" title="{{ swatch_name | escape }}"{% if value.variant.id == card_product.selected_or_first_available_variant.id %} aria-current="true"{% endif %}>
                {% if value.swatch.image %}
                  {{ value.swatch.image | image_url: width: 60 | image_tag: alt: swatch_name, loading: 'lazy' }}
                {% elsif value.swatch.color %}
                  <span style="background: {{ value.swatch.color }}"></span>
                {% endif %}
              </a>
              {% endif %}
            {% endif %}
          {% endfor %}
        {% endfor %}
        {% unless has_option_swatches %}
          {% render 'product-color-metafield', color_product: card_product %}
        {% endunless %}
      </div>
    {% endif %}
    {% unless editorial %}
      {% if card_action != blank %}<div class="product-card__action">{{ card_action }}</div>{% endif %}
    {% endunless %}
  </div>
  {% if editorial %}{{ card_action }}{% endif %}
</article>
