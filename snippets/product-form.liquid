{% doc %}
  Native purchase form; editable controls use this form's ID.
  @param {product} product - The product.
  @param {string} instance_id - Unique section identifier.
  @param {boolean} accelerated - Show native accelerated checkout.
{% enddoc %}
{% assign current_variant = product.selected_or_first_available_variant %}
{% assign product_form_id = 'ProductForm-' | append: instance_id %}
{% form 'product', product, id: product_form_id, data-product-form: '' %}
  {{ form.errors | default_errors }}
  {% if product.selling_plan_groups.size > 0 %}
    <label for="Plan-{{ instance_id }}">{{ 'commerce.selling_plan' | t }}</label>
    <select id="Plan-{{ instance_id }}" name="selling_plan" data-selling-plan>
      {% unless product.requires_selling_plan %}<option value="">{{ 'commerce.one_time' | t }}</option>{% endunless %}
      {% for group in product.selling_plan_groups %}
        <optgroup label="{{ group.name | escape }}">
          {% for plan in group.selling_plans %}
            <option value="{{ plan.id }}"{% if product.selected_selling_plan.id == plan.id %} selected{% endif %}>{{ plan.name | escape }}</option>
          {% endfor %}
        </optgroup>
      {% endfor %}
    </select>
  {% endif %}
  <button type="submit" data-add-button data-available-label="{{ 'commerce.add_to_cart' | t }}" data-unavailable-label="{{ 'commerce.sold_out' | t }}" data-invalid-label="{{ 'commerce.unavailable' | t }}"{% unless current_variant.available %} disabled{% endunless %}>
    {% if current_variant.available %}{{ 'commerce.add_to_cart' | t }}{% else %}{{ 'commerce.sold_out' | t }}{% endif %}
  </button>
  <p data-product-error role="alert" hidden></p>
  {% if accelerated %}{{ form | payment_button }}{% endif %}
  {{ form | payment_terms }}
{% endform %}
