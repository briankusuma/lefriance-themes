{% doc %}
  Progressive product form. Variant select and checkout work without JavaScript.
  @param {product} product - The product.
  @param {string} instance_id - Unique section identifier.
  @param {boolean} accelerated - Show native accelerated checkout.
{% enddoc %}
{% assign current_variant = product.selected_or_first_available_variant %}
{% assign product_form_id = 'ProductForm-' | append: instance_id %}
<noscript><form action="{{ product.url }}" method="get">
  <label for="ReviewVariant-{{ instance_id }}">{{ 'commerce.variant' | t }}</label>
  <select id="ReviewVariant-{{ instance_id }}" name="variant">{% for variant in product.variants %}<option value="{{ variant.id }}"{% if variant.id == current_variant.id %} selected{% endif %}>{{ variant.title | escape }}</option>{% endfor %}</select>
  <button type="submit">{{ 'commerce.review_variant' | t }}</button>
</form></noscript>
<lefriance-product>
  <div data-product-price>{% render 'price', item: current_variant %}</div>
  {% form 'product', product, id: product_form_id, data-product-form: '' %}
    {{ form.errors | default_errors }}
    {% unless product.has_only_default_variant %}<div data-product-options hidden>{% for option in product.options_with_values %}
      <label for="Option-{{ instance_id }}-{{ forloop.index }}">{{ option.name | escape }}</label>
      <select id="Option-{{ instance_id }}-{{ forloop.index }}" data-option-select>{% for value in option.values %}<option value="{{ value | escape }}"{% if value.selected %} selected{% endif %}>{{ value | escape }}</option>{% endfor %}</select>
    {% endfor %}</div>{% endunless %}
    <label data-variant-label for="Variant-{{ instance_id }}">{{ 'commerce.variant' | t }}</label>
    <select id="Variant-{{ instance_id }}" name="id" data-variant-select>
      {% for variant in product.variants %}<option value="{{ variant.id }}"{% if variant.id == current_variant.id %} selected{% endif %}>{{ variant.title | escape }} — {{ variant.price | money }}{% unless variant.available %} — {{ 'commerce.sold_out' | t }}{% endunless %}</option>{% endfor %}
    </select>
    {% if product.selling_plan_groups.size > 0 %}
      <label for="Plan-{{ instance_id }}">{{ 'commerce.selling_plan' | t }}</label>
      <select id="Plan-{{ instance_id }}" name="selling_plan" data-selling-plan>
        {% unless product.requires_selling_plan %}<option value="">{{ 'commerce.one_time' | t }}</option>{% endunless %}
        {% for group in product.selling_plan_groups %}<optgroup label="{{ group.name | escape }}">{% for plan in group.selling_plans %}<option value="{{ plan.id }}"{% if product.selected_selling_plan.id == plan.id %} selected{% endif %}>{{ plan.name | escape }}</option>{% endfor %}</optgroup>{% endfor %}
      </select>
    {% endif %}
    <label for="ProductQuantity-{{ instance_id }}">{{ 'commerce.quantity' | t }}</label>
    <input id="ProductQuantity-{{ instance_id }}" name="quantity" type="number" value="{{ current_variant.quantity_rule.min | default: 1 }}" min="{{ current_variant.quantity_rule.min | default: 1 }}" step="{{ current_variant.quantity_rule.increment | default: 1 }}"{% if current_variant.quantity_rule.max %} max="{{ current_variant.quantity_rule.max }}"{% endif %}>
    <button type="submit" data-add-button data-available-label="{{ 'commerce.add_to_cart' | t }}" data-unavailable-label="{{ 'commerce.sold_out' | t }}" data-invalid-label="{{ 'commerce.unavailable' | t }}"{% unless current_variant.available %} disabled{% endunless %}>{% if current_variant.available %}{{ 'commerce.add_to_cart' | t }}{% else %}{{ 'commerce.sold_out' | t }}{% endif %}</button>
    <p data-product-error role="alert" hidden></p>
    {% if accelerated %}{{ form | payment_button }}{% endif %}
    {{ form | payment_terms }}
  {% endform %}
  <p>{% if cart.taxes_included %}{{ 'commerce.tax_included' | t }}{% else %}{{ 'commerce.tax_at_checkout' | t }}{% endif %}</p>
  <script type="application/json" data-product-variants>[
    {% for variant in product.variants %}{% capture price_markup %}{% render 'price', item: variant %}{% endcapture %}
      {"id":{{ variant.id | json }},"available":{{ variant.available | json }},"options":{{ variant.options | json }},"price":{{ price_markup | json }},"media":{{ variant.featured_media.id | default: 0 | json }},"min":{{ variant.quantity_rule.min | default: 1 | json }},"max":{{ variant.quantity_rule.max | default: 0 | json }},"step":{{ variant.quantity_rule.increment | default: 1 | json }},"plans":[{% for allocation in variant.selling_plan_allocations %}{% capture plan_price %}{{ allocation.price | money_with_currency }}{% endcapture %}{"id":{{ allocation.selling_plan.id | json }},"price":{{ plan_price | json }}}{% unless forloop.last %},{% endunless %}{% endfor %}]}{% unless forloop.last %},{% endunless %}
    {% endfor %}
  ]</script>
</lefriance-product>
