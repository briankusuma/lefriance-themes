{% doc %}
  Render server-formatted prices, including unit pricing.
  @param {object} item - A variant, product, or cart line.
{% enddoc %}
<span class="price">
  {% if item.compare_at_price > item.price %}<s>{% if settings.show_currency_code %}{{ item.compare_at_price | money_with_currency }}{% else %}{{ item.compare_at_price | money }}{% endif %}</s>{% endif %}
  <span>{% if settings.show_currency_code %}{{ item.price | money_with_currency }}{% else %}{{ item.price | money }}{% endif %}{% if item.price_varies %} – {% if settings.show_currency_code %}{{ item.price_max | money_with_currency }}{% else %}{{ item.price_max | money }}{% endif %}{% endif %}</span>
  {% assign unit_item = item.selected_or_first_available_variant | default: item %}
  {% if unit_item.unit_price_measurement %}<small>{{ unit_item.unit_price | unit_price_with_measurement: unit_item.unit_price_measurement }}</small>{% endif %}
</span>
